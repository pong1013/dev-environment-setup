#!/usr/bin/env bash
set -euo pipefail

TARGET="${BASH_SOURCE[0]}"
while [ -L "$TARGET" ]; do
  DIR="$( cd -P "$( dirname "$TARGET" )" >/dev/null 2>&1 && pwd )"
  TARGET="$(readlink "$TARGET")"
  [[ $TARGET != /* ]] && TARGET="$DIR/$TARGET"
done
SCRIPT_DIR="$( cd -P "$( dirname "$TARGET" )" >/dev/null 2>&1 && pwd )"

source "${SCRIPT_DIR}/core/paths.sh"
source "${SCRIPT_DIR}/modules/log.sh"
source "${SCRIPT_DIR}/core/validate.sh"
source "${SCRIPT_DIR}/modules/prompt.sh"
source "${SCRIPT_DIR}/modules/network.sh"
source "${SCRIPT_DIR}/modules/docker.sh"
source "${SCRIPT_DIR}/modules/vm.sh"
source "${SCRIPT_DIR}/generators/container_render.sh"
source "${SCRIPT_DIR}/generators/vm_render.sh"
source "${SCRIPT_DIR}/modules/status.sh"
source "${SCRIPT_DIR}/modules/help.sh"
source "${SCRIPT_DIR}/commands/create.sh"
source "${SCRIPT_DIR}/commands/start.sh"
source "${SCRIPT_DIR}/commands/stop.sh"
source "${SCRIPT_DIR}/commands/status.sh"
source "${SCRIPT_DIR}/commands/doctor.sh"
source "${SCRIPT_DIR}/commands/shell.sh"
source "${SCRIPT_DIR}/commands/clean.sh"

command="${1:-start}"
env_name_arg="${2:-}"

case "${command}" in
  start)
    do_start "${@:2}"
    ;;
  create)
    do_create "${@:2}"
    ;;
  stop)
    do_stop "${@:2}"
    ;;
  status)
    do_status "${@:2}"
    ;;
  doctor)
    do_doctor "${@:2}"
    ;;
  shell)
    do_shell "${@:2}"
    ;;
  help|-h|--help)
    do_help "${@:2}"
    ;;
  clean)
    do_clean "${@:2}"
    ;;
  *)
    log_error "Unknown command: ${command}"
    log_info "Available commands: start | create | stop | status | doctor | shell | clean | help"
    exit 1
    ;;
esac
